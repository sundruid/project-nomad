# Copy this file to .env and replace all CHANGE_ME values before starting.
# Quote paths that contain spaces.
NOMAD_DATA_DIR='/absolute/path/to/project-nomad-data'
NOMAD_PORT=8080
NOMAD_APP_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
NOMAD_DB_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
NOMAD_MYSQL_ROOT_PASSWORD=CHANGE_ME_RANDOM_ROOT_PASSWORD

# Optional bearer key for an authenticated OpenAI-compatible server such as Unsloth Studio.
# Leave blank for Ollama, LM Studio, and other servers that do not require authentication.
NOMAD_REMOTE_AI_API_KEY=
